# Fornax server: every variable it reads, with invented example values. Copy to .env (never commit .env).

# Required. A random string of at least 32 characters; it signs upload, download and result links.
# For example: openssl rand -base64 48
FORNAX_SECRET=replace-me-with-a-random-string-of-at-least-32-characters
# The public address: scheme and host only (Fornax is served at the root).
PUBLIC_URL=https://fornax.example.com
# The database (fornax.db) and the job files (files/) live here.
DATA_DIR=/data
PORT=3000
HOST=0.0.0.0
# How many reverse proxies in front of Fornax may set X-Forwarded-* headers (0: none).
TRUST_PROXY=1
LOG_LEVEL=info
FORNAX_MAX_UPLOAD_MB=4096
FORNAX_MAX_OUTPUT_MB=4096
FORNAX_MAX_QUEUED_PER_TOKEN=50
FORNAX_FINISHED_DAYS=14
FORNAX_ORPHAN_UPLOAD_HOURS=24
FORNAX_UNAVAILABLE_TYPE_DAYS=7
FORNAX_PENDING_TOKEN_DAYS=7
# Allowed callback_url prefixes, comma-separated, each ending with "/". Empty: webhooks are off.
FORNAX_WEBHOOK_PREFIXES=https://app.example.com/hooks/
# The worker bundle served at /downloads/fornax-worker.zip. The Docker image ships one: leave this empty there.
FORNAX_WORKER_ZIP=
