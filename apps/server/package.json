{
  "name": "@fornax/server",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "files": ["dist", "drizzle"],
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "fornax-admin": "dist/src/admin.js"
  },
  "exports": {
    "./testing": {
      "fornax-source": "./src/testing.ts",
      "default": "./dist/src/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fornax/protocol": "workspace:*",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "sharp": "^0.35.5",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
