{
  "name": "@fornax/tray",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "description": "The Fornax tray app (Tauri 2): starts the worker, shows the card and the queue.",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "tauri:build": "tauri build",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite --host 127.0.0.1 --port 1422 --strictPort",
    "test:rust": "pnpm build:web && cargo test --manifest-path src-tauri/Cargo.toml",
    "icons": "node scripts/icons.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "typescript": "^7.0.2",
    "vite": "8.3.6",
    "vitest": "^5.1.0"
  }
}
