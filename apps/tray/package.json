{
  "name": "@fornax/tray",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "The Fornax tray app (Tauri 2): starts the worker, shows and orders the queue.",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
